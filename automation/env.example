# Copy to .env and fill in (never commit .env)

# Azure AD app registration (application / client credentials)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- Certificate authentication (required for SharePoint REST API) ---
# SharePoint REST API (_api/v2.1) REQUIRES certificate auth, not client secrets.
# See SETUP_CERTIFICATE.md for how to generate and configure.
CERT_PATH=
CERT_THUMBPRINT=
# CERT_PASSWORD=  # Only needed if using .pfx format

# SharePoint: recordings folder (Graph drive + folder item id)
# Find via Graph Explorer: GET /sites/{hostname}:/sites/path:/drive
RECORDINGS_DRIVE_ID=b!xLku9Qi6G0WtyX7Ep0SmE-Kfp76E6RZPkCZDVzjqznFoS7iujABpT5SRCTZqoFXf
# Path inside that library (slashes). Default matches NewcleuxOS Recordings folder.
# RECORDINGS_FOLDER_PATH=Newcleux Product and Tech/Recordings
RECORDINGS_FOLDER_ID=
# Set to 1 or pass --recursive so .vtt/.txt under nested Teams folders are found (not only top level).
# RECORDINGS_RECURSIVE=0

# Where to upload .txt transcripts. Omit both to upload next to recordings (same folder).
# TRANSCRIPTS_DRIVE_ID=
# TRANSCRIPTS_FOLDER_ID=

# Optional: S3 bucket for transcript backup
AWS_REGION=us-east-1
S3_BUCKET=
# Uses default AWS credential chain (env keys, ~/.aws/credentials, IAM role)

# Path to project root (parent of transcribe.py and .venv with faster-whisper)
PROJECT_ROOT=/Users/waleedtahir/Documents/audio-text

# Optional: SharePoint site Graph key (hostname,siteCollectionId,siteId). Default in graph_smoke_test.py is NewcleuxOS.
# SHAREPOINT_SITE_ID=fashco.sharepoint.com,GUID,GUID

# --- Graph webhook (webhook_server.py) ---
# Long random string; must match clientState when you POST /subscriptions
# WEBHOOK_CLIENT_STATE=
# WEBHOOK_PORT=8787
# WEBHOOK_HOST=0.0.0.0
# Set to 1 so webhook runs poll with --teams-transcript (Teams .vtt/.txt only, no Whisper)
# WEBHOOK_TEAMS_TRANSCRIPT=0
#
# Set to 1 so webhook runs fetch_sharepoint_stream_transcripts.py (.mp4 → plain .txt + upload).
# Requires CERT_PATH / CERT_THUMBPRINT and SharePoint Sites.* permission. Overrides WEBHOOK_TEAMS_TRANSCRIPT.
# WEBHOOK_STREAM_TRANSCRIPT=0

# --- Teams transcript pull (no local Whisper) ---
# poll_sharepoint_transcribe.py --teams-transcript
# Optional extra extensions (comma-separated, with dots): TEAMS_TRANSCRIPT_EXTENSIONS=.vtt,.txt

# --- Graph meeting transcripts (when Stream has Download but NO file in Recordings folder) ---
# App needs: OnlineMeetingTranscript.Read.All (application) + admin consent
# Teams: New-CsApplicationAccessPolicy + Grant-CsApplicationAccessPolicy to the organizer
#   (403 on .../transcripts/.../content without this policy — see fetch_teams_graph_transcripts.py)
#   https://learn.microsoft.com/en-us/graph/cloud-communication-online-meeting-application-access-policy
# TRANSCRIPT_ORGANIZER_USER_ID=
# 
# TRANSCRIPT_START_ISO=2026-03-01T00:00:00Z
# TRANSCRIPT_END_ISO=2026-04-30T23:59:59Z
# Run: .venv/bin/python automation/fetch_teams_graph_transcripts.py
# Note: channel meetings may be unsupported — see script docstring.

# After filling TENANT_ID / CLIENT_ID / CLIENT_SECRET, verify the app (NOT Graph Explorer — different permissions):
#   from automation/: ../.venv/bin/python graph_smoke_test.py

# Local test (real download + transcribe + SharePoint upload):
#   .venv/bin/python poll_sharepoint_transcribe.py --limit 1 --keep-local-copy
# Second unprocessed file only (skip first in Graph list order):
#   .venv/bin/python poll_sharepoint_transcribe.py --skip 1 --limit 1 --keep-local-copy
# List everything Graph sees in Recordings (check for .vtt next to .mp4):
#   .venv/bin/python poll_sharepoint_transcribe.py --list-files
# Teams-generated transcript files only (.vtt → plain .txt, or copy .txt):
#   .venv/bin/python poll_sharepoint_transcribe.py --teams-transcript --limit 1 --keep-local-copy
# One specific file by Graph item id (Graph Explorer → copy id):
#   .venv/bin/python poll_sharepoint_transcribe.py --item-id DRIVEITEMGUID --force --keep-local-copy

# Optional: email fallback (Graph: needs Mail.Send application permission + USER_ID mailbox)
MAIL_ON_SHAREPOINT_FAILURE=1
MAIL_SENDER_USER_ID=
MAIL_TO=you@company.com
